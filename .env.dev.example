# 开发环境存档模板。不提交真实密钥。
# 用法：cp .env.dev.example .env.dev  → 填密钥 → cp .env.dev .env
# 运行时只读 .env（及进程环境变量），不会直接读本文件。

# --- 应用 ---
APP_NAME=gewe-wechat-bot
APP_VERSION=0.1.0
APP_ENV=dev
# 仅 dev | test | prod
DEBUG=true
# prod 必须 false
API_V1_PREFIX=/api/v1
# 自有接口前缀；回调不走这里

# --- 服务 ---
HOST=0.0.0.0
PORT=8000

# --- 数据库（PostgreSQL，程序用 DB_* 拼连接串，不要设 DATABASE_URL）---
DB_HOST=localhost
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=
DB_NAME=gewe_dev
# 测试用 gewe_test，生产用 gewe_prod

# --- 百炼（OpenAI 兼容；Key 不要写进本文件）---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 控制台「OpenAI 兼容」地址
# 模型 id 与生成参数（temperature/max_tokens/thinking/超时）是 app/agno/models/ 里的常量，不进 env
REPLY_HISTORY_ROUNDS=20
# 给模型的已送达轮数
CHAT_STORE_ROUNDS=200
# 会话 JSON 最多存的轮数（> 模型窗口）
# 执行节点 → Agent 映射。空 = 全部走默认 Agent。格式 本号wxid:agent_id,...
NODE_AGENTS=

# --- GeWe ---
GEWE_BASE_URL=http://api.geweapi.com
# 调 GeWe 开放接口用，不要拿去验回调
GEWE_TOKEN=
# 空=白名单关闭。非空=本号wxid:好友|好友,...
GEWE_ALLOWLIST=
# 回调鉴权；空或对不上都 401。GeWe 回调把该值原样放在 Authorization 头。与 GEWE_TOKEN 分开
WEBHOOK_SECRET=
GEWE_HTTP_TIMEOUT=20.0
# postText HTTP 超时秒；outbox 租约只覆盖这段

# --- 生成 / 准入 ---
INBOX_CONCURRENCY_GLOBAL=6
# 同时生成的会话上限（全局）
INBOX_CONCURRENCY_PER_ACCOUNT=2
# 每个本号 wxid 同时生成的会话上限
INBOX_BATCH_MAX=10
# 同会话一次认领几条（连发合并）
DEBOUNCE_MS=10000
# 相邻间隔上限；不超过则并入同一批，并从最后一条再等这么久
OUTBOX_BACKLOG_PER_ACCOUNT=20
# 该节点待发超过此数则停生成
INBOX_LEASE_SECONDS=360
# 生成租约；崩溃后超时退回 pending
INBOX_LEASE_GRACE_SECONDS=30
# 回收宽限，避免刚超时就被扫走

# --- 发放（每个本号 wxid 一套；间隔管常态，桶只兜底）---
SEND_MAX_DISTINCT_FRIENDS_PER_MINUTE=10
# 真正安全线：1 分钟内不同好友数（集合，同一人再发不算新）
SEND_MAX_PER_MINUTE=40
# 条数硬顶，防突发
SEND_BURST=2
# 令牌桶容量，务必小；重启后最多连发这么多条
SEND_DAILY_CAP=200
# 每节点每天最多发几条（业务日见 QUOTA_TZ）
SEND_INTERVAL_SAME_MS=1500-3500
# 同一好友两条间隔（毫秒，随机）
SEND_INTERVAL_DIFF_MS=4000-8000
# 不同好友两条间隔（毫秒，随机）
SEND_LEASE_SECONDS=60
# 发送租约，只覆盖 HTTP，不含等待
SEND_LEASE_GRACE_SECONDS=30
# 发送回收宽限
SEND_MAX_ATTEMPTS=2
# 含首次；超时只再试一次
QUOTA_TZ=Asia/Shanghai
# 「今天」按这个时区切日

# --- worker 轮询 ---
WORKER_POLL_SECONDS=1.0
# worker 空转轮询间隔秒
RECLAIM_INTERVAL_SECONDS=15.0
# 租约回收扫描间隔秒
